#version 450
/*
 * sha256_comp.comp — Vulkan compute kernel for Anubis SHA-256 proof of work.
 *
 * Each invocation hashes one candidate nonce from a shared prefix midstate:
 *
 *   mode 0 (fast/slow):  message = prefix || decimal(nonce)      + padding
 *   mode 1 (sha256):     message = prefix || u32 nonce [le|be]   + padding
 *
 * The prefix is a whole number of 64-byte blocks, so the tail (nonce +
 * padding + length) always fits in one block. Prefix blocks are folded into
 * `midstate` on the host.
 *
 * Matches are appended to a small results buffer; the host re-verifies them
 * with the CPU implementation before accepting.
 */

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Params {
    uint midstate[8];
    uint prefix_len;   /* bytes, multiple of 64 */
    uint mode;         /* 0 = decimal nonce, 1 = fixed 4-byte nonce */
    uint use_le;       /* fixed4: 1 = little-endian nonce bytes */
    uint difficulty;   /* nibbles for mode 0, bits for mode 1 */
    uint check_bits;   /* 0 = nibbles, 1 = bits */
    uint base_nonce;   /* u32; the search is capped at 2^32 */
    uint chunk;        /* invocations in this dispatch (unused) */
};

layout(std430, binding = 1) buffer Results {
    uint count;
    uint pad0;
    uint pad1;
    uint pad2;
    uint nonces[8];
    uint hashes[8][8];
};

const uint K[64] = uint[](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr(uint x, uint n) {
    return (x >> n) | (x << (32u - n));
}

void put_byte(inout uint w[16], uint pos, uint b) {
    w[pos >> 2] |= b << (24u - 8u * (pos & 3u));
}

uint byte_at(uint h[8], uint i) {
    return (h[i >> 2] >> (24u - 8u * (i & 3u))) & 0xFFu;
}

void compress(inout uint h[8], in uint w[16]) {
    uint ww[64];
    for (int i = 0; i < 16; i++) {
        ww[i] = w[i];
    }
    for (int i = 16; i < 64; i++) {
        uint s0 = rotr(ww[i - 15], 7u) ^ rotr(ww[i - 15], 18u) ^ (ww[i - 15] >> 3u);
        uint s1 = rotr(ww[i - 2], 17u) ^ rotr(ww[i - 2], 19u) ^ (ww[i - 2] >> 10u);
        ww[i] = ww[i - 16] + s0 + ww[i - 7] + s1;
    }

    uint a = h[0], b = h[1], c = h[2], d = h[3];
    uint e = h[4], f = h[5], g = h[6], hh = h[7];

    for (int i = 0; i < 64; i++) {
        uint s1 = rotr(e, 6u) ^ rotr(e, 11u) ^ rotr(e, 25u);
        uint ch = (e & f) ^ ((~e) & g);
        uint t1 = hh + s1 + ch + K[i] + ww[i];
        uint s0 = rotr(a, 2u) ^ rotr(a, 13u) ^ rotr(a, 22u);
        uint maj = (a & b) ^ (a & c) ^ (b & c);
        uint t2 = s0 + maj;
        hh = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

bool nibbles_ok(uint h[8], uint diff) {
    for (uint i = 0u; i < diff / 2u; i++) {
        if (byte_at(h, i) != 0u) return false;
    }
    if ((diff & 1u) != 0u) {
        if ((byte_at(h, diff / 2u) >> 4u) != 0u) return false;
    }
    return true;
}

bool bits_ok(uint h[8], uint diff) {
    uint full = diff / 8u;
    uint rem = diff % 8u;
    for (uint i = 0u; i < full; i++) {
        if (byte_at(h, i) != 0u) return false;
    }
    if (rem != 0u) {
        uint mask = 0xFFu << (8u - rem);
        if ((byte_at(h, full) & mask) != 0u) return false;
    }
    return true;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint nonce = base_nonce + gid;

    uint w[16];
    for (int i = 0; i < 16; i++) {
        w[i] = 0u;
    }

    if (mode == 0u) {
        /* Decimal nonce, most significant digit first. Digits are extracted
         * into scalars (constant indices) and the three message words are
         * assembled per digit count, which keeps everything in registers. */
        uint q = nonce;
        uint d0 = q % 10u; q /= 10u;
        uint d1 = q % 10u; q /= 10u;
        uint d2 = q % 10u; q /= 10u;
        uint d3 = q % 10u; q /= 10u;
        uint d4 = q % 10u; q /= 10u;
        uint d5 = q % 10u; q /= 10u;
        uint d6 = q % 10u; q /= 10u;
        uint d7 = q % 10u; q /= 10u;
        uint d8 = q % 10u; q /= 10u;
        uint d9 = q % 10u;

        uint n0 = 48u + d0, n1 = 48u + d1, n2 = 48u + d2;
        uint n3 = 48u + d3, n4 = 48u + d4, n5 = 48u + d5;
        uint n6 = 48u + d6, n7 = 48u + d7, n8 = 48u + d8;
        uint n9 = 48u + d9;

        uint d = 1u;
        if (nonce >= 10u) d = 2u;
        if (nonce >= 100u) d = 3u;
        if (nonce >= 1000u) d = 4u;
        if (nonce >= 10000u) d = 5u;
        if (nonce >= 100000u) d = 6u;
        if (nonce >= 1000000u) d = 7u;
        if (nonce >= 10000000u) d = 8u;
        if (nonce >= 100000000u) d = 9u;
        if (nonce >= 1000000000u) d = 10u;

        if (d == 1u) {
            w[0] = (n0 << 24u) | (0x80u << 16u);
        } else if (d == 2u) {
            w[0] = (n1 << 24u) | (n0 << 16u) | (0x80u << 8u);
        } else if (d == 3u) {
            w[0] = (n2 << 24u) | (n1 << 16u) | (n0 << 8u) | 0x80u;
        } else if (d == 4u) {
            w[0] = (n3 << 24u) | (n2 << 16u) | (n1 << 8u) | n0;
            w[1] = 0x80000000u;
        } else if (d == 5u) {
            w[0] = (n4 << 24u) | (n3 << 16u) | (n2 << 8u) | n1;
            w[1] = (n0 << 24u) | 0x800000u;
        } else if (d == 6u) {
            w[0] = (n5 << 24u) | (n4 << 16u) | (n3 << 8u) | n2;
            w[1] = (n1 << 24u) | (n0 << 16u) | (0x80u << 8u);
        } else if (d == 7u) {
            w[0] = (n6 << 24u) | (n5 << 16u) | (n4 << 8u) | n3;
            w[1] = (n2 << 24u) | (n1 << 16u) | (n0 << 8u) | 0x80u;
        } else if (d == 8u) {
            w[0] = (n7 << 24u) | (n6 << 16u) | (n5 << 8u) | n4;
            w[1] = (n3 << 24u) | (n2 << 16u) | (n1 << 8u) | n0;
            w[2] = 0x80000000u;
        } else if (d == 9u) {
            w[0] = (n8 << 24u) | (n7 << 16u) | (n6 << 8u) | n5;
            w[1] = (n4 << 24u) | (n3 << 16u) | (n2 << 8u) | n1;
            w[2] = (n0 << 24u) | (0x80u << 16u);
        } else {
            w[0] = (n9 << 24u) | (n8 << 16u) | (n7 << 8u) | n6;
            w[1] = (n5 << 24u) | (n4 << 16u) | (n3 << 8u) | n2;
            w[2] = (n1 << 24u) | (n0 << 16u) | (0x80u << 8u);
        }
        w[15] = (prefix_len + d) * 8u;
    } else {
        if (use_le == 1u) {
            w[0] = ((nonce & 0xFFu) << 24u) | ((nonce & 0xFF00u) << 8u) |
                   ((nonce >> 8u) & 0xFF00u) | ((nonce >> 24u) & 0xFFu);
        } else {
            w[0] = nonce;
        }
        w[1] = 0x80000000u;
        w[15] = (prefix_len + 4u) * 8u;
    }

    uint h[8];
    for (int i = 0; i < 8; i++) {
        h[i] = midstate[i];
    }
    compress(h, w);

    bool ok = (check_bits == 1u) ? bits_ok(h, difficulty) : nibbles_ok(h, difficulty);
    if (ok) {
        uint slot = atomicAdd(count, 1u);
        if (slot < 8u) {
            nonces[slot] = nonce;
            for (int i = 0; i < 8; i++) {
                hashes[slot][i] = h[i];
            }
        }
    }
}
