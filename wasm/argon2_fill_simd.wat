    (local.set $q3 (v128.xor (local.get $q3) (local.get $q5)))
    (local.set $q3 (i8x16.shuffle 3 4 5 6 7 0 1 2 11 12 13 14 15 8 9 10 (local.get $q3) (local.get $q3)))
