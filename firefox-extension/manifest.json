{
  "manifest_version": 2,
  "name": "Anubis native solver",
  "version": "2.56.1",
  "description": "Solve Anubis proof-of-work challenges with the native C engine, WebGPU or the better WebAssembly kernel instead of the in-page solver.",
  "browser_specific_settings": {
    "gecko": {
      "id": "anubis-solver@celikfana-lab",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "tabs",
    "notifications",
    "storage",
    "*://*/*",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "block.js",
      "stats-store.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "anubis-solver \u2014 solve history",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "webgpu/gpu-solver.js",
        "stats-store.js",
        "look.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    "wasm/*",
    "webgpu/*",
    "mascot/*"
  ]
}
