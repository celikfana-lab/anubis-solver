    (local.set $q7 (v128.xor (local.get $q7) (local.get $q1)))
    (local.set $q7 (i8x16.shuffle 2 3 4 5 6 7 0 1 10 11 12 13 14 15 8 9 (local.get $q7) (local.get $q7)))
    (local.set $t0 (i8x16.shuffle 0 1 2 3 8 9 10 11 0 1 2 3 8 9 10 11 (local.get $q5) (local.get $q5)))
    (local.set $t1 (i8x16.shuffle 0 1 2 3 8 9 10 11 0 1 2 3 8 9 10 11 (local.get $q7) (local.get $q7)))
    (local.set $t2 (i64x2.extmul_low_i32x4_u (local.get $t0) (local.get $t1)))
    (local.set $q5 (i64x2.add (i64x2.add (local.get $q5) (local.get $q7)) (i64x2.add (local.get $t2) (local.get $t2))))
    (local.set $q3 (v128.xor (local.get $q3) (local.get $q5)))
    (local.set $q3 (v128.xor (i64x2.shl (local.get $q3) (i32.const 1)) (i64x2.shr_u (local.get $q3) (i32.const 63))))
