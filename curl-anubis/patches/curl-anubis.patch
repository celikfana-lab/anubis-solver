+#ifndef HEADER_CURL_TOOL_ANUBIS_H
+#define HEADER_CURL_TOOL_ANUBIS_H
+/***************************************************************************
+ *                                  _   _ ____  _
+ *  Project                     ___| | | |  _ \| |
+ *                             / __| | | | |_) | |
+ *                            | (__| |_| |  _ <| |___
