 size_t tool_write_cb(char *buffer, size_t sz, size_t nmemb, void *userdata)
+{
+  struct per_transfer *per = userdata;
+
+  /* curl-anubis: hold the first bytes of a body back until we know whether
+   * they are the gate's challenge page. Anything that is not is written
+   * from here, unchanged. */
+  if(per && anubis_sniff(per, buffer, sz * nmemb))
+    return sz * nmemb;
+
+  return tool_write_cb_body(buffer, sz, nmemb, userdata);
+}
