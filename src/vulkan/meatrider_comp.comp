#version 450
/*
 * meatrider_comp.comp — Vulkan compute kernel for the `meatrider` tier.
 *
 * The tier is SHA-256d over a real 80-byte Bitcoin block header. One hash is
 * two compressions:
 *
 *   h1 = compress(midstate, block1(nonce))
 *   h2 = compress(IV, block2(h1))
 *   digest = the 32 bytes of h2, reversed        <- Bitcoin display order
 *
 * `midstate` is the state after header bytes 0..63, folded on the host once
 * per challenge, so only block 1's four nonce bytes move between candidates.
 *
 * Block 2 is the pleasant part: its message words w0..w7 ARE the eight words
 * of h1, because SHA-256 reads a block as big-endian words and block 2 is the
 * big-endian first digest. So the second block needs no byte shuffling at all,
 * only w8 = 0x80, w15 = 0x100.
 *
 * The leading-zero-bits test runs on the display-order words (reversed and
 * byteswapped), and hits are appended to a small results buffer. The host
 * re-derives every digest in C before believing it.
 */

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Params {
    uint midstate[8];   /* SHA-256 state after header bytes 0..63 */
    uint tail[3];       /* header bytes 64..75, little-endian words */
    uint difficulty;    /* leading zero bits of the display-order digest */
    uint base_nonce;    /* u32; the search is capped at 2^32 */
    uint chunk;         /* invocations in this dispatch (unused) */
};

layout(std430, binding = 1) buffer Results {
    uint count;
    uint pad0;
    uint pad1;
    uint pad2;
    uint nonces[8];
    uint hashes[8][8];  /* display-order digest, as big-endian words */
};

const uint K[64] = uint[](
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
    0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
    0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
    0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
    0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
    0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
    0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
    0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
);

uint rotr(uint x, uint n) {
    return (x >> n) | (x << (32u - n));
}

uint byteswap(uint x) {
    return (x >> 24) | ((x >> 8) & 0x0000ff00u) |
           ((x << 8) & 0x00ff0000u) | (x << 24);
}

void compress(inout uint h[8], in uint w[16]) {
    uint ww[64];
    for (int i = 0; i < 16; i++) {
        ww[i] = w[i];
    }
    for (int i = 16; i < 64; i++) {
        uint s0 = rotr(ww[i - 15], 7u) ^ rotr(ww[i - 15], 18u) ^ (ww[i - 15] >> 3u);
        uint s1 = rotr(ww[i - 2], 17u) ^ rotr(ww[i - 2], 19u) ^ (ww[i - 2] >> 10u);
        ww[i] = ww[i - 16] + s0 + ww[i - 7] + s1;
    }

    uint a = h[0], b = h[1], c = h[2], d = h[3];
    uint e = h[4], f = h[5], g = h[6], hh = h[7];

    for (int i = 0; i < 64; i++) {
        uint s1 = rotr(e, 6u) ^ rotr(e, 11u) ^ rotr(e, 25u);
        uint ch = (e & f) ^ ((~e) & g);
        uint t1 = hh + s1 + ch + K[i] + ww[i];
        uint s0 = rotr(a, 2u) ^ rotr(a, 13u) ^ rotr(a, 22u);
        uint maj = (a & b) ^ (a & c) ^ (b & c);
        uint t2 = s0 + maj;
        hh = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }

    h[0] += a; h[1] += b; h[2] += c; h[3] += d;
    h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
}

/* Leading zero bits of the display-order digest. The words are big-endian, so
 * a whole zero word is 32 bits and a partial one is its top `bits` bits. */
bool meets(uint dg[8], uint difficulty) {
    uint need = difficulty;
    for (uint w = 0u; w < 8u && need > 0u; w++) {
        uint bits = need >= 32u ? 32u : need;
        uint mask = bits == 32u ? 0xFFFFFFFFu : (0xFFFFFFFFu << (32u - bits));
        if ((dg[w] & mask) != 0u) {
            return false;
        }
        need -= bits;
    }
    return true;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= chunk) {
        return;
    }
    uint nonce = base_nonce + gid;

    /* block 1: header bytes 64..79, the 0x80, and the 640-bit length.
     * `tail` arrives as little-endian words and the nonce is a host integer,
     * but a SHA-256 message word is the big-endian reading of its four bytes,
     * so both have to be byteswapped. (This is the classic Bitcoin gotcha:
     * nBits and the nonce are little-endian in the header, big-endian in the
     * message schedule.) */
    uint w[16];
    w[0] = byteswap(tail[0]);
    w[1] = byteswap(tail[1]);
    w[2] = byteswap(tail[2]);
    w[3] = byteswap(nonce);
    w[4] = 0x80000000u;
    w[5] = 0u; w[6] = 0u; w[7] = 0u;
    w[8] = 0u; w[9] = 0u; w[10] = 0u; w[11] = 0u;
    w[12] = 0u; w[13] = 0u; w[14] = 0u;
    w[15] = 0x00000280u;

    uint h[8];
    for (int i = 0; i < 8; i++) {
        h[i] = midstate[i];
    }
    compress(h, w);

    /* block 2: the first digest's words are its message words */
    w[0] = h[0]; w[1] = h[1]; w[2] = h[2]; w[3] = h[3];
    w[4] = h[4]; w[5] = h[5]; w[6] = h[6]; w[7] = h[7];
    w[8] = 0x80000000u;
    w[9] = 0u; w[10] = 0u; w[11] = 0u;
    w[12] = 0u; w[13] = 0u; w[14] = 0u;
    w[15] = 0x00000100u;

    h[0] = 0x6a09e667u; h[1] = 0xbb67ae85u; h[2] = 0x3c6ef372u;
    h[3] = 0xa54ff53au; h[4] = 0x510e527fu; h[5] = 0x9b05688cu;
    h[6] = 0x1f83d9abu; h[7] = 0x5be0cd19u;
    compress(h, w);

    /* display order: reverse the word order and byteswap each word */
    uint dg[8];
    for (int i = 0; i < 8; i++) {
        dg[i] = byteswap(h[7 - i]);
    }

    if (meets(dg, difficulty)) {
        uint slot = atomicAdd(count, 1u);
        if (slot < 8u) {
            nonces[slot] = nonce;
            for (int i = 0; i < 8; i++) {
                hashes[slot][i] = dg[i];
            }
        }
    }
}
