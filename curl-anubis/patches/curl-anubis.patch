+#include "tool_setup.h"
+
+struct per_transfer;
+
+/* How much of a response body is held back while we decide whether it is an
+ * Anubis challenge page. The challenge script sits in the first couple of
+ * kilobytes of every page Anubis serves; 16 KiB is generous, and a body that
+ * is not a challenge is flushed as soon as the window is filled. */
+#define ANUBIS_SNIFF_MAX (16 * 1024)
+
+struct anubis_state {
+  bool enabled;    /* --anubis in effect for this transfer */
+  bool sniffing;   /* still holding the first bytes back, undecided */
+  bool challenge;  /* the held-back bytes are a challenge page */
+  int attempts;    /* how many challenges already solved for this transfer */
+  size_t len;      /* bytes in buf */
+  char *buf;       /* the held-back prefix of the body, malloced */
+};
+
+/* Called before a transfer starts: arms the sniffer and, when the user did
+ * not choose a User-Agent, gives Anubis a browser one. */
+void anubis_begin(struct per_transfer *per);
+
+/* Called with each received body chunk. Returns TRUE when the chunk has been
+ * dealt with here (held back, or flushed as a non-challenge) and the caller
+ * must not write it; FALSE when the caller should write it normally. */
+bool anubis_sniff(struct per_transfer *per, const char *buf, size_t len);
+
+/* Write out a body that was held back and turned out not to be a challenge;
+ * needed at the end of a transfer shorter than the sniff window. */
+void anubis_flush_pending(struct per_transfer *per);
+
+/* TRUE when a challenge page is buffered and not yet answered. */
+bool anubis_pending(struct per_transfer *per);
+
+/* Solve the buffered challenge, collect the auth cookie and arm a retry.
+ * Returns TRUE when the transfer should be retried. When it returns FALSE the
+ * buffered page is written out as the response, the way plain curl would. */
+bool anubis_handle_challenge(struct per_transfer *per);
+
+/* Release anything held for this transfer. */
+void anubis_free(struct per_transfer *per);
+
+#endif /* HEADER_CURL_TOOL_ANUBIS_H */
