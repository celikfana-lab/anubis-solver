    (local.set $t2 (i64x2.extmul_low_i32x4_u (local.get $t0) (local.get $t1)))
    (local.set $q4 (i64x2.add (i64x2.add (local.get $q4) (local.get $q6)) (i64x2.add (local.get $t2) (local.get $t2))))
    (local.set $q2 (v128.xor (local.get $q2) (local.get $q4)))
    (local.set $q2 (i8x16.shuffle 3 4 5 6 7 0 1 2 11 12 13 14 15 8 9 10 (local.get $q2) (local.get $q2)))
