;; Argon2id fill_block with explicit v128 SIMD, generated by
;; tools/gen_argon2_wat_simd.py. Two u64 per register; the diagonal G's
;; need shuffles, the column G's pair exactly. Uses i64x2.extmul_low_i32x4_u,
;; which Rust's stable core::arch::wasm32 does not expose.
(module
    (memory (export "memory") 320)
    ;; scratch: block_tmp at 0, blockR at 1024; caller blocks at 2048+
    (func (export "fill_block") (param $dst i32) (param $prev i32) (param $ref i32) (param $xor i32)
      (local $i i32) (local $base i32)
      (local $q0 v128) (local $q1 v128) (local $q2 v128) (local $q3 v128)
      (local $q4 v128) (local $q5 v128) (local $q6 v128) (local $q7 v128)
      (local $b0 v128) (local $d0 v128)
      (local $t0 v128) (local $t1 v128) (local $t2 v128)
    
    ;; ---- blockR = ref ^ prev ; block_tmp = blockR ^ (xor ? dst : 0), 2 words at a time ----
    (local.set $i (i32.const 0))
    (block $copy_done (loop $copy
      (br_if $copy_done (i32.ge_u (local.get $i) (i32.const 1024)))
      (v128.store (i32.add (i32.const 1024) (local.get $i))
        (v128.xor (v128.load (i32.add (local.get $ref) (local.get $i)))
                  (v128.load (i32.add (local.get $prev) (local.get $i)))))
      (if (local.get $xor) (then
        (v128.store (local.get $i)
          (v128.xor (v128.load (i32.add (i32.const 1024) (local.get $i)))
                    (v128.load (i32.add (local.get $dst) (local.get $i))))))
       (else
        (v128.store (local.get $i) (v128.load (i32.add (i32.const 1024) (local.get $i))))))
      (local.set $i (i32.add (local.get $i) (i32.const 16)))
      (br $copy)))
    
    ;; ---- 8 column rounds and 8 row rounds ----
    (local.set $base (i32.const 1024))
    ;; column round 0: words 0..15
    (local.set $q0 (v128.load offset=0 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q1 (v128.load offset=16 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q2 (v128.load offset=32 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q3 (v128.load offset=48 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q4 (v128.load offset=64 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q5 (v128.load offset=80 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q6 (v128.load offset=96 (i32.add (local.get $base) (i32.const 0))))
    (local.set $q7 (v128.load offset=112 (i32.add (local.get $base) (i32.const 0))))
    ;; column 0: columns G(i,i+4,i+8,i+12) for i=0,1 / 2,3
    (local.set $t0 (i8x16.shuffle 0 1 2 3 8 9 10 11 0 1 2 3 8 9 10 11 (local.get $q0) (local.get $q0)))
    (local.set $t1 (i8x16.shuffle 0 1 2 3 8 9 10 11 0 1 2 3 8 9 10 11 (local.get $q2) (local.get $q2)))
    (local.set $t2 (i64x2.extmul_low_i32x4_u (local.get $t0) (local.get $t1)))
    (local.set $q0 (i64x2.add (i64x2.add (local.get $q0) (local.get $q2)) (i64x2.add (local.get $t2) (local.get $t2))))
    (local.set $q6 (v128.xor (local.get $q6) (local.get $q0)))
